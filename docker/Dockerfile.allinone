# FreeCash Solo ALL-IN-ONE: freecashd + stratum + dashboard
# Portainer: nur YAML paste → fertig
FROM python:3.12-slim-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    FCH_DATADIR=/opt/newcoin \
    FCH_RPCUSER=fchrpc \
    FCH_RPCPASS=FreecashSoloAutoRpc_ChangeMeIfPublic \
    FCH_RPCPORT=8332 \
    FCH_P2PPORT=8333

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ca-certificates unzip tar gzip \
    libboost-system1.74.0 libboost-filesystem1.74.0 libboost-thread1.74.0 \
    libboost-chrono1.74.0 libboost-program-options1.74.0 libevent-2.1-7 \
    libssl3 libdb5.3 libminiupnpc17 libzmq5 \
    && rm -rf /var/lib/apt/lists/*

# Offizielles FreeCash-Node-Image (fc.io) → Binaries extrahieren
WORKDIR /tmp/fc
RUN curl -fsSL -o fc.zip \
      "https://github.com/freecashorg/freecash/releases/download/v1.0.5/fc_miner_docker_1.0.5.zip" \
 && unzip -q fc.zip \
 && tar xf fc_miner_1.0.5/fc.io_1.0.5.tar.gz \
 && mkdir -p /usr/local/bin \
 && tar xf 58e660eee10845db7d57aa5446435af651405077ce93350abac33261e37d3969/layer.tar -C / usr/local/bin/freecashd \
 && tar xf 857b354a787190b399012286ec8ac6553516b44d8da71713a1f72855db0cb5c2/layer.tar -C / usr/local/bin/freecash-cli \
 && chmod +x /usr/local/bin/freecashd /usr/local/bin/freecash-cli \
 && freecashd -version || true \
 && rm -rf /tmp/fc

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY stratum/ ./stratum/
COPY monitor/ ./monitor/
COPY config/ ./config/
COPY scripts/ ./scripts/
COPY docker/entrypoint.allinone.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh scripts/*.py 2>/dev/null || true \
 && mkdir -p /opt/newcoin /app/data /app/logs /app/config

EXPOSE 8333 8332 3333 5000

VOLUME ["/opt/newcoin", "/app/data", "/app/config"]

ENTRYPOINT ["/entrypoint.sh"]
