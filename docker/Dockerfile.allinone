# FreeCash Solo ALL-IN-ONE
# freecashd from official release needs libboost_system.so.1.58.0 → Ubuntu 16.04 (xenial)
FROM ubuntu:16.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    FCH_DATADIR=/opt/newcoin \
    FCH_RPCUSER=fchrpc \
    FCH_RPCPASS=FreecashSoloAutoRpc_ChangeMeIfPublic \
    FCH_RPCPORT=8332 \
    FCH_P2PPORT=8333 \
    PATH=/opt/conda/bin:/usr/local/bin:/usr/bin:/bin

# Xenial is EOL → old-releases
RUN sed -i 's|http://archive.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' /etc/apt/sources.list \
 && sed -i 's|http://security.ubuntu.com/ubuntu|http://old-releases.ubuntu.com/ubuntu|g' /etc/apt/sources.list \
 && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip tar gzip \
    libboost-system1.58.0 \
    libboost-filesystem1.58.0 \
    libboost-chrono1.58.0 \
    libboost-program-options1.58.0 \
    libboost-thread1.58.0 \
    libboost-date-time1.58.0 \
    libssl1.0.0 \
    libevent-2.0-5 \
    libevent-pthreads-2.0-5 \
    libdb5.3 \
    libminiupnpc10 \
    libzmq5 \
    libstdc++6 \
    && rm -rf /var/lib/apt/lists/*

# freecashd + freecash-cli from official docker image layers
WORKDIR /tmp/fc
RUN curl -fsSL -o fc.zip \
      "https://github.com/freecashorg/freecash/releases/download/v1.0.5/fc_miner_docker_1.0.5.zip" \
 && unzip -q fc.zip \
 && tar xf fc_miner_1.0.5/fc.io_1.0.5.tar.gz \
 && tar xf 58e660eee10845db7d57aa5446435af651405077ce93350abac33261e37d3969/layer.tar -C / usr/local/bin/freecashd \
 && tar xf 857b354a787190b399012286ec8ac6553516b44d8da71713a1f72855db0cb5c2/layer.tar -C / usr/local/bin/freecash-cli \
 && chmod +x /usr/local/bin/freecashd /usr/local/bin/freecash-cli \
 && freecashd -version \
 && rm -rf /tmp/fc

# Miniconda = modern Python on old Ubuntu
RUN curl -fsSL https://repo.anaconda.com/miniconda/Miniconda3-py312_24.7.1-0-Linux-x86_64.sh -o /tmp/mc.sh \
 && bash /tmp/mc.sh -b -p /opt/conda \
 && rm /tmp/mc.sh \
 && /opt/conda/bin/conda clean -afy

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY stratum/ ./stratum/
COPY monitor/ ./monitor/
COPY config/ ./config/
COPY scripts/ ./scripts/
COPY docker/entrypoint.allinone.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh \
 && mkdir -p /opt/newcoin /app/data /app/logs /app/config

EXPOSE 8333 8332 3333 5000
VOLUME ["/opt/newcoin", "/app/data", "/app/config"]

ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
