# FreeCash Solo Stack - Environment

# RPC credentials (change these!)
RPC_USER=freecashrpc
RPC_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# Dashboard
DASHBOARD_PORT=8080
DASHBOARD_SECRET_KEY=change-me-too

# Node data path on host (for Portainer volume)
# Example for Synology / Unraid / TrueNAS:
# NODE_DATA=/volume1/docker/freecash/data
NODE_DATA=./data/freecash

# Optional: your FCH payout address (for display & future stratum)
FCH_ADDRESS=FYourAddressHere

# Stratum listen (if enabled)
STRATUM_PORT=3333
